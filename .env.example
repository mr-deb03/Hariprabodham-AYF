# Frontend environment variables (Create React App reads REACT_APP_* at build/start).
# Copy to .env.local for local dev, and set the same keys in Vercel → Settings →
# Environment Variables for production. Restart `npm start` after editing.

# Smruti face-match backend (Hugging Face Space)
REACT_APP_SMRUTI_ENDPOINT=https://your-space.hf.space/api/smruti

# Smruti → WhatsApp delivery, via the Cloudflare Worker relay. When set, the
# form asks for a WhatsApp number and the photos are sent straight there (no
# Telegram step). Blank → the Telegram deep-link flow is used instead.
#   https://<your-worker>.workers.dev/smruti/whatsapp
REACT_APP_SMRUTI_WA_ENDPOINT=

# Birthday wishes — the `birthday-wishes` Supabase Edge Function (see
# supabase/SETUP.md § 6), which sends the approved WhatsApp template via Meta's
# Cloud API. The daily cron sends automatically; this URL only powers the
# portal's optional "Send now" button. Blank = sender not configured yet.
#   https://<PROJECT_REF>.supabase.co/functions/v1/birthday-wishes
REACT_APP_NOTIFY_ENDPOINT=

# Karyakarta Portal — Supabase (Project Settings → API). Publishable key is client-safe.
REACT_APP_SUPABASE_URL=https://xxxx.supabase.co
REACT_APP_SUPABASE_ANON_KEY=sb_publishable_xxx

# YouTube auto-sync (YouTube Data API v3 key, restrict it by HTTP referrer to your domain)
REACT_APP_YT_API_KEY=
# Channel id (UC…) or @handle — drives the public videos shown in the Media section
REACT_APP_YT_CHANNEL_ID=
# Unlisted "Karyakarta" playlist id — drives the gated Satsang Videos in the portal
REACT_APP_YT_MEMBER_PLAYLIST=

# Instagram auto-sync — the `instagram-feed` Supabase Edge Function (see
# supabase/SETUP.md § 7). Instagram has no referrer-restricted key like
# YouTube's, so the access token lives in the function, never here.
# Blank = the Media page falls back to the curated reels in MediaGallery.jsx.
#   https://<PROJECT_REF>.supabase.co/functions/v1/instagram-feed
REACT_APP_IG_ENDPOINT=

# Attendance report → Google Sheet export (optional). Deploy
# supabase/report-sheet-appscript.gs as a Web app and paste its /exec URL here.
REACT_APP_REPORT_SHEET_WEBHOOK=
